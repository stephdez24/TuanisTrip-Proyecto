import { prisma } from "../src/config/prisma";
import bcrypt from "bcryptjs";

async function main() {
    console.log("Iniciando seed...");
     // Roles
    const administrador = await prisma.rol.upsert({
        where: { nombre: "Administrador" },
        update: {},
        create: {
            nombre: "Administrador",
            descripcion: "Usuario con acceso completo al sistema.",
            activo: true,
        },
    });

    await prisma.rol.upsert({
        where: { nombre: "Empleado" },
        update: {},
        create: {
            nombre: "Empleado",
            descripcion: "Usuario encargado de atender citas asignadas.",
            activo: true,
        },
    });

    await prisma.rol.upsert({
        where: { nombre: "Cliente" },
        update: {},
        create: {
            nombre: "Cliente",
            descripcion: "Usuario que puede consultar sus citas y cancelarlas cuando corresponda.",
            activo: true,
        },
    });

    // Estados de cita
    await prisma.estadoCita.upsert({
        where: { nombre: "Pendiente" },
        update: {},
        create: {
            nombre: "Pendiente",
            descripcion: "Cita registrada, pendiente de confirmación.",
            bloqueaDisponibilidad: true,
            permiteCancelacionCliente: true,
            permiteEdicion: true,
            color: "amarillo",
            orden: 1,
            activo: true,
        },
    });

    await prisma.estadoCita.upsert({
        where: { nombre: "Confirmada" },
        update: {},
        create: {
            nombre: "Confirmada",
            descripcion: "Cita confirmada por el establecimiento.",
            bloqueaDisponibilidad: true,
            permiteCancelacionCliente: false,
            permiteEdicion: true,
            color: "azul",
            orden: 2,
            activo: true,
        },
    });

    await prisma.estadoCita.upsert({
        where: { nombre: "En proceso" },
        update: {},
        create: {
            nombre: "En proceso",
            descripcion: "Cita que se encuentra siendo atendida.",
            bloqueaDisponibilidad: true,
            permiteCancelacionCliente: false,
            permiteEdicion: false,
            color: "morado",
            orden: 3,
            activo: true,
        },
    });

    await prisma.estadoCita.upsert({
        where: { nombre: "Finalizada" },
        update: {},
        create: {
            nombre: "Finalizada",
            descripcion: "Cita atendida y finalizada.",
            bloqueaDisponibilidad: false,
            permiteCancelacionCliente: false,
            permiteEdicion: false,
            color: "verde",
            orden: 4,
            activo: true,
        },
    });

    await prisma.estadoCita.upsert({
        where: { nombre: "Cancelada" },
        update: {},
        create: {
            nombre: "Cancelada",
            descripcion: "Cita cancelada. No bloquea disponibilidad.",
            bloqueaDisponibilidad: false,
            permiteCancelacionCliente: false,
            permiteEdicion: false,
            color: "rojo",
            orden: 5,
            activo: true,
        },
    });

    // Días de semana
    const dias = [
        { nombre: "Lunes", numeroOrden: 1 },
        { nombre: "Martes", numeroOrden: 2 },
        { nombre: "Miércoles", numeroOrden: 3 },
        { nombre: "Jueves", numeroOrden: 4 },
        { nombre: "Viernes", numeroOrden: 5 },
        { nombre: "Sábado", numeroOrden: 6 },
        { nombre: "Domingo", numeroOrden: 7 },
    ];

    for (const dia of dias) {
        await prisma.diaSemana.upsert({
            where: { nombre: dia.nombre },
            update: {},
            create: dia,
        });
    }

    // ============================================================
    // Horario de atención del establecimiento (datos iniciales propios
    // del equipo, requeridos por el enunciado: "Horario para todos los
    // días de atención"). Mismo horario para los 7 días: 08:00–17:00.
    // Las columnas son TIME puro (sin zona horaria): se construyen igual
    // que lo hace horaParaTimeColumn() en el backend, con sufijo "Z" para
    // que se guarden literales sin desfase de zona horaria.
    // ============================================================
    const todosLosDias = await prisma.diaSemana.findMany();
    const horaAperturaEstablecimiento = new Date("1970-01-01T08:00:00Z");
    const horaCierreEstablecimiento = new Date("1970-01-01T17:00:00Z");

    for (const dia of todosLosDias) {
        await prisma.horarioAtencion.upsert({
            where: {
                diaSemanaId_horaInicio_horaFin: {
                    diaSemanaId: dia.id,
                    horaInicio: horaAperturaEstablecimiento,
                    horaFin: horaCierreEstablecimiento,
                },
            },
            update: {},
            create: {
                diaSemanaId: dia.id,
                horaInicio: horaAperturaEstablecimiento,
                horaFin: horaCierreEstablecimiento,
                activo: true,
            },
        });
    }

    // Tipos de restricción
    await prisma.tipoRestriccionHorario.upsert({
        where: { nombre: "General del establecimiento" },
        update: {},
        create: {
            nombre: "General del establecimiento",
            descripcion: "Restricción que afecta a todos los empleados del establecimiento.",
        },
    });

    await prisma.tipoRestriccionHorario.upsert({
        where: { nombre: "Específica de empleado" },
        update: {},
        create: {
            nombre: "Específica de empleado",
            descripcion: "Restricción que afecta únicamente a un empleado específico.",
        },
    });

    await prisma.tipoRestriccionHorario.upsert({
        where: { nombre: "Parcial por horas" },
        update: {},
        create: {
            nombre: "Parcial por horas",
            descripcion: "Restricción aplicada a un rango específico de horas.",
        },
    });

    await prisma.tipoRestriccionHorario.upsert({
        where: { nombre: "Día completo" },
        update: {},
        create: {
            nombre: "Día completo",
            descripcion: "Restricción que bloquea todo el día seleccionado.",
        },
    });

    // Especialidad base (provista por el enunciado, no se elimina)
    await prisma.especialidad.upsert({
        where: { nombre: "General" },
        update: {},
        create: {
            nombre: "General",
            descripcion: "Especialidad base para servicios y empleados generales.",
            activo: true,
        },
    });

    // ============================================================
    // Especialidades propias del equipo (temática Tuanis Trip).
    // Coinciden con las 3 categorías de tour del mini-proyecto
    // original: Playa, Montaña, Ciudad.
    // ============================================================
    await prisma.especialidad.upsert({
        where: { nombre: "Playa" },
        update: {},
        create: {
            nombre: "Playa",
            descripcion: "Tours y guías especializados en actividades costeras y acuáticas.",
            activo: true,
        },
    });

    await prisma.especialidad.upsert({
        where: { nombre: "Montaña" },
        update: {},
        create: {
            nombre: "Montaña",
            descripcion: "Tours y guías especializados en senderismo, volcanes y bosque nuboso.",
            activo: true,
        },
    });

    await prisma.especialidad.upsert({
        where: { nombre: "Ciudad" },
        update: {},
        create: {
            nombre: "Ciudad",
            descripcion: "Tours y guías especializados en recorridos urbanos, historia y gastronomía.",
            activo: true,
        },
    });

    // Usuario administrador
    const passwordHash = await bcrypt.hash("Admin12345", 10);

    await prisma.usuario.upsert({
        where: { correo: "admin@citas.com" },
        update: {},
        create: {
            nombre: "Administrador",
            primerApellido: "Sistema",
            segundoApellido: null,
            correo: "admin@citas.com",
            telefono: "88888888",
            passwordHash,
            activo: true,
            rolId: administrador.id,
        },
    });

    // ============================================================
    // Usuarios con rol Empleado (datos iniciales propios del equipo).
    // Nombres reales de los 9 guías del mini-proyecto original. El
    // registro de "Guía" en sí (código, especialidad, tours asignados)
    // se crea después desde el FrontEnd, en /guias/nuevo — esto solo
    // prepara las CUENTAS de usuario que ese formulario necesita.
    // ============================================================
    const rolEmpleado = await prisma.rol.findUniqueOrThrow({
        where: { nombre: "Empleado" },
    });

    const passwordHashEmpleado = await bcrypt.hash("Guia12345", 10);

    const guiasIniciales = [
        { nombre: "Sofía", primerApellido: "Vargas", correo: "sofia.vargas@tuanistrip.com", telefono: "87777777" },
        { nombre: "Diego", primerApellido: "Rojas", correo: "diego.rojas@tuanistrip.com", telefono: "88888881" },
        { nombre: "Mariana", primerApellido: "López", correo: "mariana.lopez@tuanistrip.com", telefono: "89999999" },
        { nombre: "Carlos", primerApellido: "Jiménez", correo: "carlos.jimenez@tuanistrip.com", telefono: "86666666" },
        { nombre: "Andrea", primerApellido: "Solano", correo: "andrea.solano@tuanistrip.com", telefono: "80000000" },
        { nombre: "Luis", primerApellido: "Mora", correo: "luis.mora@tuanistrip.com", telefono: "81111111" },
        { nombre: "Valeria", primerApellido: "Castro", correo: "valeria.castro@tuanistrip.com", telefono: "83333333" },
        { nombre: "Pablo", primerApellido: "Herrera", correo: "pablo.herrera@tuanistrip.com", telefono: "84444444" },
        { nombre: "Fernanda", primerApellido: "Ruiz", correo: "fernanda.ruiz@tuanistrip.com", telefono: "85555555" },
        // Guías nuevos (uno por especialidad, para mantener el balance)
        { nombre: "Gabriela", primerApellido: "Méndez", correo: "gabriela.mendez@tuanistrip.com", telefono: "87123456" },
        { nombre: "Esteban", primerApellido: "Araya", correo: "esteban.araya@tuanistrip.com", telefono: "87234567" },
        { nombre: "Camila", primerApellido: "Brenes", correo: "camila.brenes@tuanistrip.com", telefono: "87345678" },
    ];

    for (const guia of guiasIniciales) {
        await prisma.usuario.upsert({
            where: { correo: guia.correo },
            update: {},
            create: {
                nombre: guia.nombre,
                primerApellido: guia.primerApellido,
                segundoApellido: null,
                correo: guia.correo,
                telefono: guia.telefono,
                passwordHash: passwordHashEmpleado,
                activo: true,
                rolId: rolEmpleado.id,
            },
        });
    }

    console.log("Horario de atención sembrado para los 7 días.");
    console.log("12 usuarios con rol Empleado creados/verificados.");
    console.log("3 especialidades adicionales creadas/verificadas.");
    console.log("Seeder ejecutado correctamente.");
}

main()
    .catch((e) => {
        console.error("Error en seed:", e);
    })
    .finally(async () => {
        await prisma.$disconnect();
    });